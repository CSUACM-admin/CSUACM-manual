---
export interface Props {
  items: string[];
}

const { items = [] } = Astro.props;
---

<ul class="checklist">
  {items.map((item) => (
    <li>
      <label>
        <input type="checkbox" />
        <span>{item}</span>
      </label>
    </li>
  ))}
</ul>

<style>
  .checklist {
    list-style: none;
    padding: 0;
  }
  .checklist li {
    margin: 0.5rem 0;
  }
  .checklist input {
    margin-right: 0.5rem;
  }
</style>
